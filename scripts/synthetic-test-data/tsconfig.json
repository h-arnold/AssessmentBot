{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals", "vite/client"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "paths": {
      "@/*": ["../../src/frontend/src/*"],
      "@synthetic/*": ["../../tests/__mocks__/data/synthetic-analysis/*"]
    }
  },
  "include": [
    "**/*.js",
    "../../tests/synthetic-analysis/**/*.ts",
    "../../tests/synthetic-analysis-stress/**/*.ts"
  ]
}
