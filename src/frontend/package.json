{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/@typescript/native/bin/tsc -b && vite build",
    "lint": "eslint src e2e-tests playwright.config.ts vite.config.ts eslint.config.js e2e-css-loader-bootstrap.mjs e2e-css-loader.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "NODE_OPTIONS=\"--import ./e2e-css-loader-bootstrap.mjs\" playwright test",
    "test:e2e:interactive": "playwright test --headed"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.104.1",
    "antd": "6.6.7",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "77.0.0",
    "globals": "latest",
    "happy-dom": "^20.14.5",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.3",
    "vitest": "^5.0.3"
  }
}
