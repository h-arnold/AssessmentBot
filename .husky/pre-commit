#!/usr/bin/env sh

# Format staged JavaScript and JSON files with Prettier, add them back to the commit,
# then run ESLint and TypeScript checks on staged files only. This keeps formatting
# consistent and validation fast by only checking what changed.

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(js|json|md|ts)$" | grep -Ev "^src/(AdminSheet|AssessmentRecordTemplate)/" || true)

if [ -n "$STAGED_FILES" ]; then
	echo "Running Prettier on staged files:"
	echo "$STAGED_FILES"
	# Run Prettier (uses local install if available, otherwise npx)
	# Process each file individually to handle filenames with spaces correctly
	if command -v npx >/dev/null 2>&1; then
		echo "$STAGED_FILES" | while IFS= read -r file; do
			npx prettier --write "$file"
		done
	else
		echo "$STAGED_FILES" | while IFS= read -r file; do
			prettier --write "$file"
		done
	fi

	# Add any changes made by Prettier back to the commit
	echo "$STAGED_FILES" | while IFS= read -r file; do
		git add "$file"
	done
fi

# Get staged files for linting (only .js and .ts files)
LINT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(js|ts)$" | grep -Ev "^src/(AdminSheet|AssessmentRecordTemplate)/" || true)

if [ -n "$LINT_FILES" ]; then
	echo "Linting staged files only..."
	
	# Separate files by component and run appropriate linters
	BACKEND_FILES=$(echo "$LINT_FILES" | grep -E "^(src/backend|tests)/.*\.js$" || true)
	FRONTEND_FILES=$(echo "$LINT_FILES" | grep -E "^src/frontend/.*\.(js|ts|tsx|jsx)$" || true)
	BUILDER_FILES=$(echo "$LINT_FILES" | grep -E "^scripts/builder/.*\.ts$" || true)
	
	# ESLint backend staged files with the main config
	if [ -n "$BACKEND_FILES" ]; then
		echo "Checking backend staged files..."
		echo "$BACKEND_FILES" | xargs -d '\n' npx eslint --config eslint.config.js --fix || exit 1
	fi
	
	# ESLint frontend staged files
	if [ -n "$FRONTEND_FILES" ]; then
		echo "Checking frontend staged files..."
		echo "$FRONTEND_FILES" | xargs -d '\n' npx eslint --config eslint.config.js --fix || exit 1
	fi
	
	# ESLint builder staged files
	if [ -n "$BUILDER_FILES" ]; then
		echo "Checking builder staged files..."
		echo "$BUILDER_FILES" | xargs -d '\n' npx eslint --config scripts/builder/eslint.config.js --fix || exit 1
	fi
fi

# TypeScript build check for builder (catches type errors early)
echo "Running TypeScript build check..."
npm run builder:compile || exit 1