{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "experimental": {
    "bashDefaultTimeoutMs": 450000
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.79", "--browser", "chromium"],
      "enabled": true
    }
  },
  "agent": {
    "explore": {
      "model": "opencode/north-mini-code-free"
    },
    "planner-reviewer": {
      "description": "Reviews planning artefacts for gaps and contradictions",
      "mode": "subagent",
      "reasoningEffort": "high"
    },
    "code-reviewer": {
      "description": "Reviews code for quality, standards adherence, and defects",
      "mode": "subagent",
      "reasoningEffort": "high"
    }
  }
}
