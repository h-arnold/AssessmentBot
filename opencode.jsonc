{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "experimental": {
    "bashDefaultTimeoutMs": 450000,
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "eslint.config.*", "effect": "ask" },
    { "action": "edit", "resource": "**/eslint.config.*", "effect": "ask" },
    { "action": "edit", "resource": ".eslint*", "effect": "ask" },
    { "action": "edit", "resource": "**/.eslint*", "effect": "ask" },
    { "action": "edit", "resource": "config/eslint/**", "effect": "ask" },
    { "action": "edit", "resource": "**/config/eslint/**", "effect": "ask" },
    { "action": "edit", "resource": "tsconfig*.json*", "effect": "ask" },
    { "action": "edit", "resource": "**/tsconfig*.json*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git reset*", "effect": "ask" },
    { "action": "shell", "resource": "git rebase*", "effect": "ask" },
    { "action": "shell", "resource": "git stash*", "effect": "ask" },
    { "action": "shell", "resource": "git reflog*", "effect": "ask" },
    { "action": "shell", "resource": "git clean*", "effect": "ask" },
    { "action": "shell", "resource": "git restore*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout --*", "effect": "ask" },
    { "action": "shell", "resource": "git rm*", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "ask" },
    { "action": "shell", "resource": "git push -f*", "effect": "ask" },
    { "action": "shell", "resource": "git revert*", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D*", "effect": "ask" },
    { "action": "shell", "resource": "git cherry-pick*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -B*", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "ask" },
    { "action": "shell", "resource": "git filter-repo*", "effect": "ask" },
    { "action": "shell", "resource": "git prune*", "effect": "ask" },
    { "action": "shell", "resource": "git gc*", "effect": "ask" },
    { "action": "shell", "resource": "git update-ref*", "effect": "ask" },
    { "action": "shell", "resource": "rmdir*", "effect": "ask" },
    { "action": "shell", "resource": "shred*", "effect": "ask" },
    { "action": "shell", "resource": "truncate*", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rm", "effect": "ask" },
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@0.0.79", "--browser", "chromium"],
        "disabled": false,
      },
    },
  },
  "agents": {
    "title": {
      "model": "opencode/mimo-v2.6-flash-free",
    },
    "explore": {
      "model": "opencode/north-mini-code-free",
    },
    "planner-reviewer": {
      "description": "Reviews planning artefacts for gaps and contradictions",
      "mode": "subagent",
    },
    "code-reviewer": {
      "description": "Reviews code for quality, standards adherence, and defects",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
    },
  },
}
