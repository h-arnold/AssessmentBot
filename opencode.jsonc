{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "small_model": "opencode/laguna-s-2.1-free",
  "experimental": {
    "bashDefaultTimeoutMs": 450000
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git reset*": "ask",
      "git rebase*": "ask",
      "git stash*": "ask",
      "git reflog*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "git checkout --*": "ask",
      "git rm*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git revert*": "ask",
      "git branch -D*": "ask",
      "git cherry-pick*": "ask",
      "git checkout -B*": "ask",
      "git filter-branch*": "ask",
      "git filter-repo*": "ask",
      "git prune*": "ask",
      "git gc*": "ask",
      "git update-ref*": "ask",
      "rmdir*": "ask",
      "shred*": "ask",
      "truncate*": "ask",
      "rm *": "ask",
      "rm": "ask"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.79", "--browser", "chromium"],
      "enabled": true
    }
  },
  "agent": {
    "explore": {
      "model": "opencode/north-mini-code-free"
    },
    "planner-reviewer": {
      "description": "Reviews planning artefacts for gaps and contradictions",
      "mode": "subagent",
      "reasoningEffort": "high"
    },
    "code-reviewer": {
      "description": "Reviews code for quality, standards adherence, and defects",
      "mode": "subagent",
      "reasoningEffort": "high"
    }
  }
}
